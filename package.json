{
  "name": "@magicturtle/claude-orchestrator",
  "version": "1.0.1",
  "description": "Claude Code orchestrator with MCP delegation - enables zero-overhead delegation to specialized Code instances with HubSpot, SharePoint, and Asana MCPs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "claude-code-mcp": "./bin/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "postinstall": "npm run setup --if-present",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "echo \"Tests coming soon\" && exit 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "claude-desktop",
    "mcp-server",
    "ai",
    "anthropic",
    "delegation",
    "orchestrator",
    "hubspot",
    "sharepoint",
    "asana",
    "parallel-execution"
  ],
  "author": "MagicTurtle-s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagicTurtle-s/claude-code-mcp-bridge.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
