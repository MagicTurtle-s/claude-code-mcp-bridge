{
  "name": "@magicturtle-s/claude-code-mcp",
  "version": "1.0.0",
  "description": "MCP server that bridges Claude Desktop to Claude Code CLI, enabling delegation to subagents",
  "main": "build/index.js",
  "bin": {
    "claude-code-mcp": "./bin/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "postinstall": "npm run setup --if-present",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "echo \"Tests coming soon\" && exit 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "mcp-server",
    "ai",
    "anthropic",
    "delegation",
    "subagents"
  ],
  "author": "MagicTurtle-s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagicTurtle-s/claude-code-mcp-bridge.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
